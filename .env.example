# Telegram Bot Token (BotFather에서 발급)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Anthropic API Key (claude.ai에서 발급)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI API Key (음성 STT용 Whisper)
OPENAI_API_KEY=your_openai_key_here

# 허용된 Telegram User ID (쉼표로 구분, 숫자)
# 예: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=your_telegram_id,husband_telegram_id,friend_telegram_id

# 관리자 ID (봇 통계 등 관리 기능 접근 가능)
ADMIN_USER_ID=your_telegram_id
